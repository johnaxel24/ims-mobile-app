{
  "expo": {
    "name": "Stockroom",
    "slug": "ims-mobile-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "imsmobileapp",
    "userInterfaceStyle": "light",
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F8FC"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
